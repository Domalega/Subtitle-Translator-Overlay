{
  "name": "subtitle-translation-overlay",
  "version": "0.2.2",
  "private": true,
  "license": "MIT",
  "productName": "Subtitle Translator Overlay",
  "description": "Always-on-top OCR overlay that translates selected English screen text into Russian.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check:files": "node scripts/check-files.js",
    "check:ui": "node scripts/check-ui-contract.js && node scripts/check-protected-ui.js",
    "test": "node scripts/run-tests.js",
    "test:ui": "node test/integration/ui-windows-smoke.js",
    "check:js": "node scripts/check-js.js",
    "check:detection-samples": "node scripts/check-detection-samples.js",
    "verify": "npm run check:files && npm run check:ui && npm run test:coverage && npm run test:ui && npm run test:ocr && npm run check:js && git diff --check",
    "prebuild": "npm run verify",
    "build": "electron-builder --win portable",
    "dist": "electron-builder --win",
    "test:coverage": "node scripts/run-tests.js --coverage",
    "test:ocr": "node test/integration/ocr-smoke.js",
    "predist": "npm run verify"
  },
  "author": "Domalega",
  "build": {
    "appId": "local.subtitle.translator.overlay",
    "productName": "Subtitle Translator Overlay",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "signExecutable": false,
      "target": [
        "portable"
      ],
      "artifactName": "Subtitle-Translator-Overlay-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "resources/ocr/eng.traineddata",
        "to": "eng.traineddata"
      }
    ]
  },
  "dependencies": {
    "pngjs": "^7.0.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "jsdom": "30.0.1"
  },
  "engines": {
    "node": ">=24.13.0"
  }
}
